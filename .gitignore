# NOTE: docs/ is INTENTIONALLY tracked.
# It is the GitHub Pages deploy root (Settings -> Pages -> Source -> /docs)
# and is regenerated by scripts/Build-Book.ps1 from sessions/<EventId>/.

# .NET build/restore artifacts from file-based programs (Get-SessionSummary.cs).
bin/
obj/
*.user
.vs/

# Editor / OS noise.
.idea/
.vscode/
*.swp
*.tmp
Thumbs.db
.DS_Store

# Local ingestion / summary run reports.
*.run-report.json
*.summary-report.json

# Local zakira-replay run artifacts. Invoke-BuildIngestion.ps1 routes mediastream
# sessions through `zakira-replay analyze`, which writes its raw run tree
# (manifest.json, evidence.json, captions/, frames/, slides/, transcript/) under
# sessions/<code>/.zakira-runs/<run-id>/. The transcript.vtt / transcript.md that
# the ingestion needs are copied back into sessions/<code>/ proper, so the
# .zakira-runs/ directory itself is recomputable and heavy (~10-40 MB per
# session). Keep it out of git.
.zakira-runs/

# Stray POSIX nul file (Windows shell artifact).
nul
